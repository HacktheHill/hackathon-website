{
	"extends": "astro/tsconfigs/strict",
	"exclude": ["build", "services/photo-gallery"],
	"baseUrl": ".",
	"compilerOptions": {
		"types": ["node"],
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"paths": {
			"@/*": ["./src/*"]
		},
		"noUnusedLocals": true,
		"noUnusedParameters": true
	}
}
