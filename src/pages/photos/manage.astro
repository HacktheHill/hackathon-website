import Photos from "../../components/Photos/Photos";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#071a3d" />
		<title>Hack the Hill III · Photo moderation</title>
		<link rel="icon" href="/Logos/hackthehill-logo.svg" type="image/svg+xml" />
	</head>
	<body>
		<Photos client:load manage />
	</body>
</html>

<style is:global>
	@font-face { font-family: "Gallery Rubik"; src: url("/fonts/rubik/Rubik-VariableFont_wght.ttf") format("truetype-variations"); font-weight: 300 900; font-display: swap; }
	* { box-sizing: border-box; }
	body { margin: 0; min-width: 320px; font-family: "Gallery Rubik", system-ui, sans-serif; background: #f7f3ed; color: #13284f; }
	button, input, textarea, select { font: inherit; }
	button { cursor: pointer; }
	button:focus-visible, input:focus-visible, textarea:focus-visible, a:focus-visible { outline: 3px solid #ee9e6f; outline-offset: 3px; }
</style>
